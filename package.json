{
  "name": "koala-cientifico",
  "displayName": "%nombre%",
  "description": "%descripcion%",
  "version": "1.6.0",
  "publisher": "jjas-029",
  "license": "MIT",
  "icon": "media/icono.png",
  "galleryBanner": {
    "color": "#2B455C",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JJAS-029/koala_monitor.git"
  },
  "bugs": {
    "url": "https://github.com/JJAS-029/koala_monitor/issues"
  },
  "homepage": "https://github.com/JJAS-029/koala_monitor#readme",
  "keywords": [
    "claude code",
    "claude",
    "mascota",
    "pet",
    "koala",
    "pomodoro",
    "uso",
    "monitor",
    "tamagotchi",
    "español"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "koalaCientifico.panel",
          "name": "%vista%"
        }
      ]
    },
    "commands": [
      {
        "command": "koalaCientifico.mostrar",
        "title": "%cmd.mostrar%",
        "category": "%categoria%"
      },
      {
        "command": "koalaCientifico.comer",
        "title": "%cmd.comer%",
        "category": "%categoria%"
      },
      {
        "command": "koalaCientifico.jugar",
        "title": "%cmd.jugar%",
        "category": "%categoria%"
      },
      {
        "command": "koalaCientifico.mimar",
        "title": "%cmd.mimar%",
        "category": "%categoria%"
      },
      {
        "command": "koalaCientifico.dormir",
        "title": "%cmd.dormir%",
        "category": "%categoria%"
      },
      {
        "command": "koalaCientifico.trabajar",
        "title": "%cmd.trabajar%",
        "category": "%categoria%"
      },
      {
        "command": "koalaCientifico.consumo",
        "title": "%cmd.consumo%",
        "category": "%categoria%"
      },
      {
        "command": "koalaCientifico.configurar",
        "title": "%cmd.configurar%",
        "category": "%categoria%"
      },
      {
        "command": "koalaCientifico.pomodoro",
        "title": "%cmd.pomodoro%",
        "category": "%categoria%"
      },
      {
        "command": "koalaCientifico.pomodoroDetener",
        "title": "%cmd.pomodoroDetener%",
        "category": "%categoria%"
      },
      {
        "command": "koalaCientifico.agregarServicio",
        "title": "%cmd.agregarServicio%",
        "category": "%categoria%"
      },
      {
        "command": "koalaCientifico.consultarAnthropic",
        "title": "%cmd.consultarAnthropic%",
        "category": "%categoria%"
      },
      {
        "command": "koalaCientifico.agua",
        "title": "%cmd.agua%",
        "category": "%categoria%"
      },
      {
        "command": "koalaCientifico.elegirCiudad",
        "title": "%cmd.elegirCiudad%",
        "category": "%categoria%"
      },
      {
        "command": "koalaCientifico.invitarVisitante",
        "title": "%cmd.invitarVisitante%",
        "category": "%categoria%"
      },
      {
        "command": "koalaCientifico.nuevaAlarma",
        "title": "%cmd.nuevaAlarma%",
        "category": "%categoria%"
      },
      {
        "command": "koalaCientifico.alarmas",
        "title": "%cmd.alarmas%",
        "category": "%categoria%"
      }
    ],
    "configuration": {
      "title": "%ajustes%",
      "properties": {
        "koalaCientifico.idioma": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "es",
            "en"
          ],
          "enumDescriptions": [
            "%cfg.idioma.0%",
            "%cfg.idioma.1%",
            "%cfg.idioma.2%"
          ],
          "description": "%cfg.idioma%"
        },
        "koalaCientifico.segundosParaDescansar": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "description": "%cfg.segundosParaDescansar%"
        },
        "koalaCientifico.reaccionarAClaude": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.reaccionarAClaude%"
        },
        "koalaCientifico.avisarEnPorcentaje": {
          "type": "number",
          "default": 90,
          "minimum": 50,
          "maximum": 100,
          "description": "%cfg.avisarEnPorcentaje%"
        },
        "koalaCientifico.pomodoro.minutosEnfoque": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "maximum": 120,
          "description": "%cfg.pomodoro.minutosEnfoque%"
        },
        "koalaCientifico.pomodoro.minutosDescanso": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "%cfg.pomodoro.minutosDescanso%"
        },
        "koalaCientifico.pomodoro.minutosDescansoLargo": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 90,
          "description": "%cfg.pomodoro.minutosDescansoLargo%"
        },
        "koalaCientifico.pomodoro.antesDeDescansoLargo": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 12,
          "description": "%cfg.pomodoro.antesDeDescansoLargo%"
        },
        "koalaCientifico.usoDesdeAnthropic": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.usoDesdeAnthropic%"
        },
        "koalaCientifico.minutosEntreConsultas": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "maximum": 60,
          "description": "%cfg.minutosEntreConsultas%"
        },
        "koalaCientifico.aguaMlPorWh": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 15,
          "description": "%cfg.aguaMlPorWh%"
        },
        "koalaCientifico.costoPlanMensualUSD": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%cfg.costoPlanMensualUSD%"
        },
        "koalaCientifico.avisarCuandoClaudeEspera": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.avisarCuandoClaudeEspera%"
        },
        "koalaCientifico.avisarTurnoLargoSegundos": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "description": "%cfg.avisarTurnoLargoSegundos%"
        },
        "koalaCientifico.reaccionarAComandos": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.reaccionarAComandos%"
        },
        "koalaCientifico.temporada": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "muertos",
            "navidad",
            "patrias",
            "anionuevo",
            "reyes",
            "marmota",
            "sanvalentin",
            "pi",
            "primavera",
            "nino",
            "madres",
            "programador",
            "pluricultural",
            "cumple",
            "ninguna"
          ],
          "enumDescriptions": [
            "%cfg.temporada.0%",
            "%cfg.temporada.1%",
            "%cfg.temporada.2%",
            "%cfg.temporada.3%",
            "%cfg.temporada.4%",
            "%cfg.temporada.5%",
            "%cfg.temporada.6%",
            "%cfg.temporada.7%",
            "%cfg.temporada.8%",
            "%cfg.temporada.9%",
            "%cfg.temporada.10%",
            "%cfg.temporada.11%",
            "%cfg.temporada.12%",
            "%cfg.temporada.13%",
            "%cfg.temporada.14%",
            "%cfg.temporada.15%"
          ],
          "description": "%cfg.temporada%"
        },
        "koalaCientifico.minutosParaSiesta": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "%cfg.minutosParaSiesta%"
        },
        "koalaCientifico.minutosParaTreparse": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "description": "%cfg.minutosParaTreparse%"
        },
        "koalaCientifico.cumpleanos": {
          "type": "string",
          "default": "",
          "pattern": "^$|^\\d{1,2}[/-]\\d{1,2}$",
          "description": "%cfg.cumpleanos%"
        },
        "koalaCientifico.clima.ciudad": {
          "type": "string",
          "default": "",
          "description": "%cfg.clima.ciudad%"
        },
        "koalaCientifico.metaAgua": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 20,
          "description": "%cfg.metaAgua%"
        },
        "koalaCientifico.minutosPausaActiva": {
          "type": "number",
          "default": 90,
          "minimum": 0,
          "description": "%cfg.minutosPausaActiva%"
        },
        "koalaCientifico.visitantes": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.visitantes%"
        },
        "koalaCientifico.sonidos": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.sonidos%"
        },
        "koalaCientifico.servicios": {
          "type": "array",
          "default": [],
          "description": "%cfg.servicios%",
          "items": {
            "type": "object",
            "properties": {
              "nombre": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "url"
            ]
          }
        },
        "koalaCientifico.barraDeEstado": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.barraDeEstado%"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test pruebas/*.test.js",
    "simular": "node pruebas/simular.js"
  }
}
